<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1" encoding="UTF-8">
  <category>
    <pattern>HI</pattern>
    <template>Hello! How can I help you today?</template>
  </category>
  <category>
    <pattern>HELLO</pattern>
    <template>Hi there! What would you like to talk about?</template>
  </category>
  <category>
    <pattern>HEY</pattern>
    <template>Hello! How can I help?</template>
  </category>
  <category>
    <pattern>GOOD MORNING</pattern>
    <template>Good morning! How can I help you?</template>
  </category>
  <category>
    <pattern>GOOD AFTERNOON</pattern>
    <template>Good afternoon! What would you like to talk about?</template>
  </category>
  <category>
    <pattern>GOOD EVENING</pattern>
    <template>Good evening! How has your day been?</template>
  </category>
  <category>
    <pattern>HOW ARE YOU</pattern>
    <template>I'm doing well and ready to chat. How are you?</template>
  </category>
  <category>
    <pattern>HOW ARE YOU *</pattern>
    <template>I'm doing well and ready to chat. How are you?</template>
  </category>
  <category>
    <pattern>THANK YOU</pattern>
    <template>You're welcome!</template>
  </category>
  <category>
    <pattern>THANKS</pattern>
    <template>You're welcome! Glad I could help.</template>
  </category>
  <category>
    <pattern>GOODBYE</pattern>
    <template>Goodbye! Take care.</template>
  </category>
  <category>
    <pattern>BYE</pattern>
    <template>See you next time!</template>
  </category>
  <category>
    <pattern>GOOD NIGHT</pattern>
    <template>Good night! Take care and rest well.</template>
  </category>
  <category>
    <pattern>TELL ME A JOKE</pattern>
    <template>Why did the scarecrow win an award? Because he was outstanding in his field!</template>
  </category>
  <category>
    <pattern>ARE YOU HUMAN</pattern>
    <template>I'm an AI chatbot, not a person. I don't have feelings or personal experiences, but I can still chat and try to help.</template>
  </category>
  <category>
    <pattern>ARE YOU A ROBOT</pattern>
    <template>I'm a chatbot program, so you could call me a virtual robot. I don't have a physical body.</template>
  </category>
  <category>
    <pattern>I AM SAD</pattern>
    <template>I'm sorry things feel difficult right now. Want to tell me a little more?</template>
  </category>
  <category>
    <pattern>I FEEL SAD</pattern>
    <template>That sounds tough. I'm here to listen if you'd like to talk about it.</template>
  </category>
  <category>
    <pattern>I AM HAPPY</pattern>
    <template>That's great to hear! What has been going well?</template>
  </category>
  <category>
    <pattern>I FEEL GREAT</pattern>
    <template>I'm glad to hear that! Want to tell me what made your day?</template>
  </category>

  <category>
    <pattern>WHAT IS AI</pattern>
    <template>Artificial intelligence is the field of building computer systems that can perform tasks such as understanding language, recognizing patterns, and making decisions.</template>
  </category>
  <category>
    <pattern>WHAT IS ARTIFICIAL INTELLIGENCE</pattern>
    <template>Artificial intelligence is the field of building computer systems that can perform tasks such as understanding language, recognizing patterns, and making decisions.</template>
  </category>
  <category>
    <pattern>WHO CREATED YOU</pattern>
    <template>I was created as a small demonstration chatbot that combines AIML rules with a machine-learning fallback.</template>
  </category>
  <category>
    <pattern>WHAT IS YOUR NAME</pattern>
    <template>I'm Chatbot. I can answer a few common questions and help you save notes.</template>
  </category>

  <category>
    <pattern>WEATHER</pattern>
    <template>I don't have a live weather service connected, so I can't check current conditions. If you share a forecast, I can help explain it.</template>
  </category>
  <category>
    <pattern>WHAT IS THE WEATHER</pattern>
    <template>I don't have a live weather service connected, so I can't check current conditions. If you share a forecast, I can help explain it.</template>
  </category>
  <category>
    <pattern>WHAT IS THE WEATHER IN *</pattern>
    <template>I don't have a live weather service connected, so I can't check current conditions for <star/>. If you share a forecast, I can help explain it.</template>
  </category>
  <category>
    <pattern>HOW IS THE WEATHER IN *</pattern>
    <template>I don't have a live weather service connected, so I can't check current conditions for <star/>. If you share a forecast, I can help explain it.</template>
  </category>
  <category>
    <pattern>WILL IT RAIN *</pattern>
    <template>I can't check live rain forecasts yet. If you share one, I can help explain it.</template>
  </category>

  <!-- main.py recognizes this marker and passes the message to ml_fallback.py. -->
  <category>
    <pattern>*</pattern>
    <template>__ML_FALLBACK__</template>
  </category>
</aiml>
